                        3.29 9.39 7.86 10.91.58.11.79-.25.79-.56
                        0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54
                        -.53-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.71.08-.71
                        1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26
                        3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28
