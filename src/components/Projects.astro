---
import ProjectGallery from "./ProjectGallery.astro";
import DisciplineVenn from "./DisciplineVenn.astro";
import { useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const p = t.projects;
const galleryLabels = t.gallery;

// image sets keep their existing order: tfm, pokemon, covid
const galleries = [
  ["/images/tfm/1.png", "/images/tfm/2.png", "/images/tfm/3.png", "/images/tfm/4.png", "/images/tfm/5.png"],
  ["/images/pokemon/1.png", "/images/pokemon/2.png", "/images/pokemon/3.png", "/images/pokemon/4.png", "/images/pokemon/5.png"],
  ["/images/covid/1.png", "/images/covid/2.png", "/images/covid/3.png", "/images/covid/4.png"],
];

const githubUrls = [
  "https://github.com/Daalma7/FairTreesAlgorithms",
  "https://github.com/Daalma7/PokemonDataScience",
  "https://github.com/Daalma7/CNNsXraysCOVID",
];
---

<section id="work" class="projects">

  <div class="projects-header">

    <p class="section-label">{p.number} — {p.label}</p>

    <div>
      <h2><Fragment set:html={p.heading} /></h2>

      <p class="projects-intro">{p.intro}</p>
    </div>

  </div>

  <DisciplineVenn lang={lang} />


  <div class="project-list">

    <div id="ai-projects" class="project-group">

    <!-- PROJECT 01 — POKÉMON -->

      <article class="project project-large">

        <div class="project-number">
          01
        </div>


        <div class="project-main">

          <div class="project-content">

            <!-- LEFT -->

            <div class="project-info">

              <div class="project-heading">

                <p class="project-category">{p.items[0].category}</p>

                <h3><Fragment set:html={p.items[0].title} /></h3>

                <h4>{p.items[0].subtitle}</h4>

              </div>


              <div class="project-description">

                <p>{p.items[0].description}</p>


                <div class="project-tech">

                  <img
                    src="https://img.shields.io/badge/Python-3776AB?style=flat-square&logo=python&logoColor=white"
                    alt="Python"
                  />

                  <img
                    src="https://img.shields.io/badge/Cython-yellow.svg?style=flat-square&logo=data:image/svg+xml;base64,"
                    alt="Cython"
                  />


                  <img
                    src="https://img.shields.io/badge/Scikit--Learn-F7931E?style=flat-square&logo=scikit-learn&logoColor=white"
                    alt="Scikit-Learn"
                  />

                  <img
                    src="https://img.shields.io/badge/Numpy-%23013243?style=flat-square&logo=numpy&logoColor=white"
                    alt="Numpy"
                  />


                  <img
                    src="https://img.shields.io/badge/Pandas-%23150458?style=flat-square&logo=pandas&logoColor=white"
                    alt="Pandas"
                  />

                  <img
                    src="https://img.shields.io/badge/Matplotlib-%23285479.svg?style=flat-square&logo=data:image/svg+xml;base64,&logoColor=white"
                    alt="Matplotlib"
                  />

                  <img
                    src="https://img.shields.io/badge/Seaborn-%2388afbb.svg?style=flat-square&logo=data:image/svg+xml;base64,&logoColor=white"
                    alt="Seaborn"
                  />

                  <img
                    src="https://img.shields.io/badge/-Plotly-3F4F75?style=flat-square&logo=plotly&logoColor=white"
                    alt="Plotly"
                  />


                </div>


                <a
                  class="project-github"
                  href={githubUrls[0]}
                  target="_blank"
                  rel="noopener noreferrer"
                >

                  <span class="github-icon">
                    <svg
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        fill="currentColor"
                        d="M12 .5C5.65.5.5 5.65.5 12c0 5.08
                        3.29 9.39 7.86 10.91.58.11.79-.25.79-.56
                        0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54
                        -.53-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.71.08-.71
                        1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26
                        3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28
                        -5.23-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46
                        .11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0
                        c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05
                        .74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25
                        5.68.41.35.78 1.04.78 2.1 0 1.52-.01 2.74-.01 3.11
                        0 .31.21.67.8.56C20.71 21.39 24 17.08 24 12
                        24 5.65 18.35.5 12 .5Z"
                      />
                    </svg>
                  </span>

                  <span>{p.viewOnGithub}</span>

                  <span class="github-arrow">
                    ↗
                  </span>

                </a>

              </div>

            </div>


            <!-- RIGHT -->

            <div class="project-gallery-wrapper">

              <ProjectGallery
                images={galleries[0]}
                alt={p.items[0].galleryAlt}
                interval={4500}
                labels={galleryLabels}
              />

            </div>

          </div>

        </div>

      </article>




