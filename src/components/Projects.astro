              </div>

            </div>


            <!-- RIGHT -->

            <div class="project-gallery-wrapper">

              <ProjectGallery
                images={galleries[2]}
                alt={p.items[2].galleryAlt}
                interval={4500}
                labels={galleryLabels}
              />

            </div>

          </div>

        </div>

      </article>

    </div>


    


    <div id="mathematics-projects" class="project-group">

      <!-- PROJECT 04 -->

      <article class="project">

        <div class="project-number">
          04
        </div>


        <div class="project-main">

          <div class="project-content">

            <div class="project-info">

              <div class="project-heading">

                <p class="project-category">{p.items[3].category}</p>

                <h3><Fragment set:html={p.items[3].title} /></h3>

                <h4>{p.items[3].subtitle}</h4>

              </div>


              <div class="project-description">

                <p>{p.items[3].description}</p>

              </div>

              <a class="project-github" href="#teaching">

                <span>{p.exploreTeaching}</span>

                <span class="github-arrow">
                  ↗
                </span>

              </a>

            </div>


            <div class="project-gallery-wrapper">

              <div class="math-placeholder">
                <span>{p.mathPlaceholder}</span>
              </div>

            </div>

          </div>

        </div>

      </article>
    
    </div>

    <div id="game-projects" class="project-group">

      <!-- PROJECT 05 -->

      <article class="project project-game">

        <div class="project-number">
          05
        </div>


        <div class="project-main">

          <div class="project-content">

            <div class="project-info">

              <div class="project-heading">

                <p class="project-category">{p.items[4].category}</p>

                <h3><Fragment set:html={p.items[4].title} /></h3>

                <h4>{p.items[4].subtitle}</h4>

              </div>


              <div class="project-description">

                <p>{p.items[4].description}</p>


                <div class="project-tech">

                  <img
                    src="https://img.shields.io/badge/Godot-478CBF?style=flat-square&logo=godot-engine&logoColor=white"
                    alt="Godot"
                    loading="lazy"
                    decoding="async"
                  />

                  <img
                    src="https://img.shields.io/badge/Game_Design-171717?style=flat-square"
                    alt="Game Design"
                    loading="lazy"
                    decoding="async"
                  />

                </div>

              </div>

            </div>


            <div class="project-gallery-wrapper">

              <div class="game-placeholder">

                <span>{p.comingSoon.kicker}</span>

                <strong><Fragment set:html={p.comingSoon.title} /></strong>

                <small>{p.comingSoon.meta}</small>

              </div>

            </div>

          </div>

        </div>

      </article>
    
    </div>

  </div>

</section>

<style>
  .projects {
    padding: var(--section-pad-y) var(--gutter);
    border-top: 1px solid var(--line);
  }

  .projects-header {
    display: grid;
    grid-template-columns: var(--col-label) 1fr;
    gap: var(--col-gap);
  }

  .projects-header h2 {
    margin: 0;
    font-size: var(--display-l);
    line-height: 0.95;
    letter-spacing: -0.05em;
    font-weight: 500;
  }

  .projects-header h2 em {
    font-family: "Playfair Display", serif;
  }

  .projects-intro {
    max-width: 52ch;
    margin-top: var(--space-xl);
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--muted);
  }

  .project-group {
    scroll-margin-top: 100px;
  }

  .project-list {
    margin-top: var(--space-3xl);
  }

  .project {
    display: grid;
    grid-template-columns: 10% 90%;
    border-top: 1px solid var(--line);
    padding: var(--space-3xl) 0;
  }

  .project:last-child {
    border-bottom: 1px solid var(--line);
  }

  .project-number {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    color: var(--muted);
  }

  .project-main {
    width: 100%;
  }

  .project-content {
    display: grid;
    grid-template-columns: minmax(280px, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(3rem, 6vw, 6rem);
    align-items: center;
  }

  .project-info {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    /* balances the gallery height on desktop */
    min-height: 500px;
  }

  .project-heading {
    max-width: 32ch;
  }

  .project-category {
    margin: 0 0 var(--space-md);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    color: var(--muted);
  }

  .project-info h3 {
    margin: 0;
    font-size: var(--display-m);
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-weight: 500;
  }

  .project-info h3 em {
    font-family: "Playfair Display", serif;
    font-weight: 500;
  }

  .project-info h4 {
    margin: var(--space-lg) 0 0;
    font-size: clamp(1.25rem, 1.7vw, 1.7rem);
    line-height: 1.15;
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  .project-description {
    max-width: 42ch;
  }

  .project-description p {
    margin: 0;
    line-height: 1.75;
    color: var(--muted);
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    align-items: center;
    margin-top: var(--space-lg);
  }

  .project-tech img {
    display: block;
    height: 20px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    border-radius: 3px;
  }

  .project-github {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    width: fit-content;
    margin-top: var(--space-lg);
    padding-bottom: var(--space-2xs);
    border-bottom: 1px solid var(--line);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition:
      border-color 0.3s ease,
      transform 0.3s ease;
  }

  .project-github:hover {
    border-color: var(--foreground);
    transform: translateX(5px);
  }

  .github-icon {
    width: 17px;
    height: 17px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .github-icon svg {
    width: 100%;
    height: 100%;
  }

  .github-arrow {
    font-size: 1rem;
    transition: transform 0.3s ease;
  }

  .project-github:hover .github-arrow {
    transform: translate(3px, -3px);
  }

  .project-gallery-wrapper {
    width: 100%;
    min-width: 0;
  }

  .project-gallery-wrapper :global(.project-gallery) {
    width: 100%;
  }

  .math-placeholder {
    width: 100%;
    height: min(65vh, 700px);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at center, rgba(196, 90, 60, 0.12), transparent 55%),
      var(--background);
  }

  .math-placeholder span {
    font-family: "Playfair Display", serif;
    font-size: clamp(2rem, 4vw, 4rem);
    color: var(--accent);
  }

  .game-placeholder {
    width: 100%;
    height: min(65vh, 700px);
    background:
      radial-gradient(circle at 70% 30%, rgba(255, 255, 255, 0.08), transparent 30%),
      #171717;
    color: #f4f2ed;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--space-md);
  }

  .game-placeholder span {
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    opacity: 0.5;
  }

  .game-placeholder strong {
    font-size: clamp(3rem, 7vw, 7rem);
    line-height: 0.9;
    font-weight: 400;
    letter-spacing: -0.06em;
  }

  .game-placeholder small {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    opacity: 0.5;
  }

  .project-gallery-wrapper,
  .math-placeholder,
  .game-placeholder {
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project:hover .project-gallery-wrapper {
    transform: scale(0.985);
  }

  @media (max-width: 900px) {
    .project-content {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .project-info {
      min-height: auto;
      gap: var(--space-2xl);
    }

    .project-gallery-wrapper {
      order: 2;
    }
  }

  @media (max-width: 700px) {
    .projects-header {
      grid-template-columns: 1fr;
    }

    .project {
      grid-template-columns: 40px 1fr;
    }

    .project-content {
      gap: var(--space-xl);
    }

    .project-info {
      gap: var(--space-xl);
    }

    .project-info h3 {
      font-size: clamp(2.5rem, 12vw, 4rem);
    }

  }
</style>
